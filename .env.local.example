# ─────────────────────────────────────────────────────────────────────────────
# SDC Invoice Tool — Environment Variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Per-service mock flags ────────────────────────────────────────────────────
# Each service defaults to MOCK unless explicitly set to "false".
# Set to "false" to activate real integrations.

NEXT_PUBLIC_USE_MOCK_SHEETS=false        # Google Sheets / Microsoft Forms
NEXT_PUBLIC_USE_MOCK_DRIVE=false         # Google Drive (PDF upload/fetch)
NEXT_PUBLIC_USE_MOCK_VALIDATION=false    # Real PDF extraction via Claude API
NEXT_PUBLIC_USE_MOCK_STORAGE=false       # Supabase (invoices, vendors, contracts, logs)
NEXT_PUBLIC_USE_MOCK_DASHBOARD=false     # Supabase-backed dashboard stats
NEXT_PUBLIC_USE_MOCK_NOTIFICATION=false  # Teams webhook notifications

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Anthropic (Claude API) ────────────────────────────────────────────────────
# Required for: PDF invoice extraction, receipt extraction, vendor/contract matching
ANTHROPIC_API_KEY=sk-ant-...

# ── Google Service Account ────────────────────────────────────────────────────
# Required when NEXT_PUBLIC_USE_MOCK_SHEETS=false or NEXT_PUBLIC_USE_MOCK_DRIVE=false
# Create a service account in GCP Console → IAM → Service Accounts
# Grant it: Google Sheets API (read), Google Drive API (read/write)
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_PROJECT_ID=your-gcp-project-id

# ── Google Sheets (invoice form source) ───────────────────────────────────────
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_SHEET_NAME=シート1
GOOGLE_SHEET_RANGE=A1:Z
GOOGLE_SHEET_HEADER_ROW=1

# ── Google Drive (invoice PDF storage) ────────────────────────────────────────
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_root_folder_id_here

# ── Microsoft / Azure (alternative to Google — for OneDrive/SharePoint forms) ─
# Only needed if using Microsoft Forms instead of Google Sheets
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# ── Teams Notifications ────────────────────────────────────────────────────────
# Required when NEXT_PUBLIC_USE_MOCK_NOTIFICATION=false
# Create an Incoming Webhook in your Teams channel
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/...

# ── Reminder settings ─────────────────────────────────────────────────────────
PAYMENT_TERMS_DAYS=30        # days after closing month end = payment due date
# CRON_SECRET=               # optional — validates GitHub Actions cron requests

# ── App defaults ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_DEFAULT_LANGUAGE=ja   # "ja" or "en"
