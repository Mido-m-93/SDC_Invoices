# ─────────────────────────────────────────────────────────────────────────────
# SDC Invoice Tool — Environment Variables
# Copy this file to .env.local and fill in values for your environment.
# Never commit .env.local to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Per-service mock flags ────────────────────────────────────────────────────
# Each service defaults to MOCK unless you explicitly set its flag to "false".
# This lets you mix real and mock services during development.
#
# To use the real Google Sheets API:
#   NEXT_PUBLIC_USE_MOCK_SHEETS=false
#
# Leave a flag unset (or set to anything other than "false") to stay on mock.

# NEXT_PUBLIC_USE_MOCK_SHEETS=false       # set to false → MicrosoftSheetsService (if AZURE vars set) or RealSheetsService
# NEXT_PUBLIC_USE_MOCK_DRIVE=false        # set to false → RealDriveService (requires GOOGLE_CLIENT_EMAIL + GOOGLE_PRIVATE_KEY)
# NEXT_PUBLIC_USE_MOCK_VALIDATION=false   # not yet implemented — do not set
# NEXT_PUBLIC_USE_MOCK_STORAGE=false      # set to false → SupabaseStorageService + Vendor/Contract/Reminder
# NEXT_PUBLIC_USE_MOCK_DASHBOARD=false    # set to false → SupabaseDashboardService

# ── Google Service Account credentials ───────────────────────────────────────
# Required when NEXT_PUBLIC_USE_MOCK_SHEETS=false (or any real service).
# Create a service account in GCP, download the JSON key, and copy values here.
#
# IMPORTANT: The private key contains real newlines in the JSON file.
# In .env.local, represent each newline as a literal \n (backslash + n).
# The service reads this and converts \n → real newlines automatically.

GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ── Google Sheets configuration ───────────────────────────────────────────────
# Required when NEXT_PUBLIC_USE_MOCK_SHEETS=false

# The spreadsheet ID — found in the Google Sheets URL:
# https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# The tab (sheet) name to read from (default: シート1)
GOOGLE_SHEET_NAME=シート1

# The A1 range to fetch — should cover all columns (default: A1:Z)
# Use a wider range like A1:AZ if the sheet has many columns
GOOGLE_SHEET_RANGE=A1:Z

# The 1-based row number that contains the column headers (default: 1)
# Set to 2 if your sheet has a title row above the headers
GOOGLE_SHEET_HEADER_ROW=1

# ── Google Drive configuration ────────────────────────────────────────────────
# Required when NEXT_PUBLIC_USE_MOCK_DRIVE=false (not yet implemented)

GOOGLE_DRIVE_ROOT_FOLDER_ID=your_root_folder_id_here

# ── Google Cloud / Firestore ──────────────────────────────────────────────────
# Required when NEXT_PUBLIC_USE_MOCK_STORAGE=false (not yet implemented)

GOOGLE_PROJECT_ID=your_gcp_project_id

# ── Supabase (client-side — auth, realtime) ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# ── Supabase (server-side — service role, bypasses RLS) ──────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Anthropic Claude ──────────────────────────────────────────────────────────
# Required for AI invoice matching (matchingService)
ANTHROPIC_API_KEY=sk-ant-...

# ── Azure / Microsoft Graph ───────────────────────────────────────────────────
# Required when NEXT_PUBLIC_USE_MOCK_SHEETS=false (MicrosoftSheetsService)
AZURE_TENANT_ID=your_tenant_id
AZURE_CLIENT_ID=your_client_id
AZURE_CLIENT_SECRET=your_client_secret
MICROSOFT_OWNER_UPN=owner@yourdomain.com
MICROSOFT_EXCEL_ITEM_ID=your_excel_item_id

# ── Microsoft Teams webhook ───────────────────────────────────────────────────
# Required for reminder notifications
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/...

# ── Cron job authentication ───────────────────────────────────────────────────
# Used by /api/reminders/send — must match the secret in GitHub Actions
CRON_SECRET=your_cron_secret_here

# ── App defaults ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_DEFAULT_LANGUAGE=ja
PAYMENT_TERMS_DAYS=30
