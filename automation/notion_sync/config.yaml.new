status_normalization:
  canonical:
  - Lead
  - Pending
  - Discovery
  - Proposal
  - Negotiation
  - Closing
  - Contracted
  - Delivery
  - Delivered
  - Lost
  jp_pipeline:
    塩漬け: Pending
    リード: Lead
    提案: Proposal
    交渉・課題確認: Negotiation
    契約準備: Closing
    成約: Contracted
    デリバリー中: Delivery
    案件終了: Delivered
    失注: Lost
  global_pipeline:
    Lead: Lead
    Pending: Pending
    Proposal requested: Proposal
    Overview explained: Discovery
    suggestion: Proposal
    Check the assignment: Discovery
    negotiation: Negotiation
    Contract preparation: Closing
    Closing: Closing
    Case Closed: Delivered
    Delivery in progress: Delivery
    Lost bet: Lost
    under estimate: Lead
    Sending the CV's: Lead
    Follow-up sent no clear response yet: Lead
    Early follow-up – email exchanged awaiting outcome: Lead
    Invited preparation suggested as next step: Lead
    Very early inquiry / under discovery: Discovery
    High potential: Lead
    Collaborative: Lead
    Follow-up planned: Lead
    Access granted: Lead
    Meeting with CEOs expected: Lead
    Rekindled interest: Lead
    Strong interest: Lead
    Referral pending: Lead
    Referred to Tetsuma: Lead
    Potential partner: Lead
    High priority: Lead
    Follow-up pending: Lead
    Exploratory / Internal strategy consideration: Discovery
    Active and included in the cluster of Taka’s key clients: Lead
    Lead is active included under Taka's client list one of the strongest opportunities from the U.S. trip: Lead
    To be shared with Pitzmin: Lead
    Multiple leads: Lead
    Salting: Pending
  old_unified: {}
