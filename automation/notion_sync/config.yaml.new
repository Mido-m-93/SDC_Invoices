deduplication:
  enabled: true
  method: token_set_ratio
  company_threshold: 92
  project_threshold: 88
  both_required: true
  min_name_length: 8
  require_non_empty_company: true
  priority_order:
  - old_unified
  - jp_pipeline
  - global_pipeline
sync:
  require_source_db: true
  preserve_original_url: true
  on_deleted: archive
logging:
  level: INFO
  dir: logs
  retention_days: 30
